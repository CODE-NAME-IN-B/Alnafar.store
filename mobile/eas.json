{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    /** نسخة المعاينة الداخلية: APK مباشر للزبون عبر GitHub Releases */
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": {
        "mode": "internal"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}

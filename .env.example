# انسخ هذا الملف إلى .env واملأ القيم (لا ترفع .env إلى GitHub)
# cp .env.example .env

# الخادم
PORT=5000
NODE_ENV=development

# Gemini AI (للتعرف على الألعاب من الصور) - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# المصادقة ولوحة التحكم (مطلوب في الإنتاج!)
JWT_SECRET=generate_a_strong_random_string_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# CORS - الأصول المسموحة (مفصولة بفاصلة)
# في الإنتاج، حدد الأصول المسموحة فقط
# ALLOWED_ORIGINS=https://alnafar.store,https://www.alnafar.store
ALLOWED_ORIGINS=

# Web Push Notifications (اختياري)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# للإنتاج: Turso (قاعدة البيانات) - مطلوب على Vercel
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# للإنتاج: Cloudinary (الصور)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# رابط المتجر (يُستخدم في الفواتير والطباعة)
# على Vercel يُستخدم VERCEL_URL تلقائياً
STORE_URL=
